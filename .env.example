# Everything here is optional. The defaults in src/config.py are the ones that
# were actually measured, so an empty .env reproduces docs/results.md.

# Ollama. Always 127.0.0.1 — `localhost` resolves to IPv6 ::1 first on this
# machine and the call hangs, which looks exactly like a crashed server.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Leave OLLAMA_MODEL unset unless you know the model is served.
#   `ollama list` is the only thing that settles it.
# The previous default here was qwen3:4b, which lives in a second model store
# the running server cannot see — every call failed on a model-not-found path
# and the failure was misread for months as "the machine is too small".
# OLLAMA_MODEL=gemma3:4b

# Cost modelling (USD per 1M tokens). Local inference is billed at zero, so the
# defaults are 0 and any non-zero value here produces a PROJECTION, not a cost.
PRICE_INPUT_PER_MTOK=0.0
PRICE_OUTPUT_PER_MTOK=0.0
# GPT-4o-mini, if you want to price the same traffic against a hosted model:
# PRICE_INPUT_PER_MTOK=0.15
# PRICE_OUTPUT_PER_MTOK=0.60

# Langfuse. Unused — src/tracer.py writes spans to runs/traces.jsonl and needs
# no account. The keys stay in Settings only so a hosted sink can be added back
# without touching the call sites.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Qdrant is gone: retrieval is an in-process dense store over data/corpus.jsonl.
